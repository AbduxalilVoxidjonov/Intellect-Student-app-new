<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ bildirishnoma ruxsati (permission_handler orqali so'raladi) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Uy joylashuvini aniqlash (geolocator) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- KIRISHDA YUZNI TASDIQLASH: yangi qurilmada selfi olinadi (camera paketi).
         image_picker uchun bu ruxsat SHART emas edi (u tashqi kamera ilovasini
         ochadi), jonli kadr olish uchun esa MAJBURIY. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Joylashuv ruxsati Play'da GPS uskunasini AVTOMAT "majburiy" deb belgilaydi va
         GPS'siz qurilmalar (ba'zi planshet/Chromebook) do'konda ilovani ko'rmay qoladi.
         Ilova GPS'siz ham to'liq ishlaydi (faqat «Uy joylashuvi» tugmasi ishlamaydi),
         shuning uchun uskuna talabini ATAYIN ixtiyoriy qilamiz. -->
    <uses-feature android:name="android.hardware.location" android:required="false"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
    <uses-feature android:name="android.hardware.location.network" android:required="false"/>
    <!-- Kamera USKUNASI ixtiyoriy: image_picker'da galereya qoladi, yuz tekshiruvi
         esa faqat YANGI qurilmada va faqat markaz yoqqan bo'lsa kerak bo'ladi.
         `required="true"` qilinsa kamerasiz qurilmalar (ba'zi planshetlar)
         ilovani Play'da umuman ko'rmasdi. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>

    <!-- allowBackup=false: ilova sessiya TOKENINI SharedPreferences'da saqlaydi, Google
         Drive'ga avtomatik zaxira (Auto Backup) yoqilgan bo'lsa token bulutga chiqib
         ketardi. Android 12+ da allowBackup faqat BULUT zaxirasini o'chiradi, qurilmadan
         -qurilmaga ko'chirish esa @xml/data_extraction_rules orqali cheklanadi. -->
    <application
        android:label="Intellect Student"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Ilova FONDA/YOPIQ bo'lganda kelgan FCM bildirishnomasi shu kanalga tushadi.
             ID lib/services/push.dart dagi PushService._channelId bilan BIR XIL bo'lishi
             shart — aks holda Android uni ovozsiz "Miscellaneous" kanaliga joylaydi. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="intellect_student_high" />
        <!-- Status bar ikonkasi: FAQAT alfa kanali ishlatiladi (oq siluet). Shu sabab
             @mipmap/ic_launcher YARAMAYDI — u shaffofsiz kvadrat bo'lgani uchun status
             bar'da oq to'rtburchak bo'lib chiqadi. ic_notification — logotipning shaffof
             fonli oq silueti (o'qituvchi ilovasi bilan bir xil fayl). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <!-- Bildirishnomadagi aksent rang (brend ko'ki). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: tashqi havolalar (Telegram/brauzer) va telefon uchun -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- Telegram ilovasini to'g'ridan-to'g'ri ochish uchun (tg://resolve...) -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tg"/>
        </intent>
    </queries>
</manifest>
